<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainFrame" prefHeight="720.0" prefWidth="980.0" styleClass="report-root" stylesheets="@ReportPage.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.main.java.controller.report.DailySalesReport">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="report-title" text="Daily Sales Report" />
                  <Label styleClass="report-subtitle" text="View bills, payments and mode-wise breakdown for a single day." />
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="report-toolbar">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="report-field-label" text="Date" />
                        <DatePicker fx:id="date" />
                     </children>
                  </VBox>
                  <CheckBox fx:id="checkCash" mnemonicParsing="false" text="CASH">
                     <font>
                        <Font name="Georgia" size="14.0" />
                     </font>
                  </CheckBox>
                  <Button fx:id="btnLoad" mnemonicParsing="false" onAction="#btnLoadAction" stylesheets="@../transaction/button.css" text="LOAD" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="CLOUD_DOWNLOAD" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnPreview" mnemonicParsing="false" onAction="#btnPreviewAction" prefHeight="30.0" stylesheets="@../transaction/button.css" text="PRIVIEW" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="EYE" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnPrint" mnemonicParsing="false" onAction="#btnExitAction" stylesheets="@../transaction/button.css" text="PRINT" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="PRINT" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnReset" mnemonicParsing="false" onAction="#btnResetAction" stylesheets="@../transaction/button.css" text="RESET" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="REFRESH" />
                     </graphic>
                  </Button>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnExit" mnemonicParsing="false" onAction="#btnExitAction" stylesheets="@../transaction/button.css" text="BACK" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="HOME" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="table" stylesheets="@../css/table.css" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colSrNo" maxWidth="80.0" minWidth="40.0" prefWidth="50.0" text="Sr.No" />
                  <TableColumn fx:id="colBillNo" maxWidth="110.0" minWidth="60.0" prefWidth="70.0" text="Bill No" />
                  <TableColumn fx:id="colBillAmount" maxWidth="130.0" minWidth="80.0" prefWidth="90.0" text="Bill Amount" />
                  <TableColumn fx:id="colPaidAmount" maxWidth="130.0" minWidth="80.0" prefWidth="90.0" text="Paid Amount" />
                  <TableColumn fx:id="colBankName" minWidth="260.0" prefWidth="420.0" text="Payment Modes" />
                  <TableColumn fx:id="colSalesmanName" minWidth="180.0" prefWidth="240.0" text="Salesman Name" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Label styleClass="breakdown-label" text="Breakdown by Payment Mode" />
            <TableView fx:id="tableModeBreakdown" minHeight="100.0" prefHeight="140.0" stylesheets="@../css/table.css">
               <columns>
                  <TableColumn fx:id="colModeName" prefWidth="400.0" text="Bank / Mode" />
                  <TableColumn fx:id="colModeAmount" prefWidth="240.0" text="Total Received" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="BOTTOM_LEFT" spacing="12.0">
               <padding>
                  <Insets top="2.0" />
               </padding>
               <children>
                  <VBox spacing="4.0" styleClass="summary-tile,summary-tile-bill" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="summary-tile-label" text="Total Bill Amount" />
                        <TextField fx:id="txtBillAmount" editable="false" prefHeight="34.0" styleClass="summary-tile-value" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" styleClass="summary-tile,summary-tile-paid" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="summary-tile-label" text="Total Paid Amount" />
                        <TextField fx:id="txtTotalPaid" editable="false" prefHeight="34.0" styleClass="summary-tile-value" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0" styleClass="summary-tile,summary-tile-unpaid" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="summary-tile-label" text="Total Unpaid Amount" />
                        <TextField fx:id="txtUnpaid" editable="false" prefHeight="34.0" styleClass="summary-tile-value" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
