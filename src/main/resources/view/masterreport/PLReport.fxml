<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="720.0" prefWidth="1100.0" styleClass="pl-root" stylesheets="@PLReport.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.main.java.controller.masterReport.PLReportController">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="pl-title" text="Profit &amp; Loss Statement" />
                  <Label styleClass="pl-subtitle" text="Year-wise revenue, cost of goods, operating expenses and net result." />
               </children>
            </VBox>

            <!-- Toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="pl-toolbar">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="pl-field-label" text="Financial Year" />
                        <ComboBox fx:id="cmbYear" prefWidth="120.0" />
                     </children>
                  </VBox>
                  <Button fx:id="btnCalculate" mnemonicParsing="false" stylesheets="@../css/button.css" text="CALCULATE" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="CALCULATOR" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnReset" mnemonicParsing="false" stylesheets="@../css/button.css" text="RESET" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="REFRESH" />
                     </graphic>
                  </Button>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnExit" mnemonicParsing="false" stylesheets="@../css/button.css" text="BACK" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontAwesomeIcon glyphName="HOME" />
                     </graphic>
                  </Button>
               </children>
            </HBox>

            <!-- KPI tiles -->
            <FlowPane hgap="14.0" vgap="14.0">
               <children>
                  <VBox spacing="6.0" prefWidth="240.0" styleClass="kpi-tile,kpi-revenue">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane styleClass="kpi-icon-bg">
                                 <children>
                                    <FontAwesomeIcon fill="WHITE" glyphName="LINE_CHART" size="18" />
                                 </children>
                              </StackPane>
                              <Label styleClass="kpi-label" text="TOTAL SALES" />
                           </children>
                        </HBox>
                        <Label fx:id="lblTotalSales" styleClass="kpi-value" text="0.00" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0" prefWidth="240.0" styleClass="kpi-tile,kpi-cost">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane styleClass="kpi-icon-bg">
                                 <children>
                                    <FontAwesomeIcon fill="WHITE" glyphName="TRUCK" size="18" />
                                 </children>
                              </StackPane>
                              <Label styleClass="kpi-label" text="TOTAL PURCHASE" />
                           </children>
                        </HBox>
                        <Label fx:id="lblTotalPurchase" styleClass="kpi-value" text="0.00" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0" prefWidth="240.0" styleClass="kpi-tile,kpi-gross">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane styleClass="kpi-icon-bg">
                                 <children>
                                    <FontAwesomeIcon fill="WHITE" glyphName="BAR_CHART" size="18" />
                                 </children>
                              </StackPane>
                              <Label styleClass="kpi-label" text="GROSS PROFIT" />
                           </children>
                        </HBox>
                        <Label fx:id="lblGrossProfit" styleClass="kpi-value" text="0.00" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0" prefWidth="240.0" styleClass="kpi-tile,kpi-expense">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane styleClass="kpi-icon-bg">
                                 <children>
                                    <FontAwesomeIcon fill="WHITE" glyphName="MONEY" size="18" />
                                 </children>
                              </StackPane>
                              <Label styleClass="kpi-label" text="OPERATING EXPENSES" />
                           </children>
                        </HBox>
                        <Label fx:id="lblTotalExpenses" styleClass="kpi-value" text="0.00" />
                     </children>
                  </VBox>

                  <VBox fx:id="netProfitTile" spacing="6.0" prefWidth="240.0" styleClass="kpi-tile,kpi-net-pos">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane styleClass="kpi-icon-bg">
                                 <children>
                                    <FontAwesomeIcon fill="WHITE" glyphName="USD" size="18" />
                                 </children>
                              </StackPane>
                              <Label fx:id="lblNetLabel" styleClass="kpi-label" text="NET PROFIT" />
                           </children>
                        </HBox>
                        <Label fx:id="lblNetProfit" styleClass="kpi-value" text="0.00" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0" prefWidth="240.0" styleClass="kpi-tile,kpi-cash">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane styleClass="kpi-icon-bg">
                                 <children>
                                    <FontAwesomeIcon fill="WHITE" glyphName="BANK" size="18" />
                                 </children>
                              </StackPane>
                              <Label styleClass="kpi-label" text="CASH COLLECTED" />
                           </children>
                        </HBox>
                        <Label fx:id="lblCashCollected" styleClass="kpi-value" text="0.00" />
                     </children>
                  </VBox>

                  <VBox spacing="6.0" prefWidth="240.0" styleClass="kpi-tile,kpi-due">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane styleClass="kpi-icon-bg">
                                 <children>
                                    <FontAwesomeIcon fill="WHITE" glyphName="EXCLAMATION_CIRCLE" size="18" />
                                 </children>
                              </StackPane>
                              <Label styleClass="kpi-label" text="OUTSTANDING RECEIVABLES" />
                           </children>
                        </HBox>
                        <Label fx:id="lblOutstanding" styleClass="kpi-value" text="0.00" />
                     </children>
                  </VBox>
               </children>
            </FlowPane>

            <!-- Detail tabs -->
            <TabPane stylesheets="@../css/tabbePane.css" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <Tab text="Summary">
                     <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                           <content>
                              <VBox spacing="14.0" styleClass="pl-card">
                                 <padding>
                                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                                 </padding>
                                 <children>
                                    <Label styleClass="pl-section-title" text="Income" />
                                    <HBox>
                                       <children>
                                          <Label styleClass="pl-row-label" text="Sales (Net of taxes)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowSalesNet" styleClass="pl-row-value" text="0.00" />
                                       </children>
                                    </HBox>
                                    <HBox>
                                       <children>
                                          <Label styleClass="pl-row-label" text="Transport charges (recovered)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowTransport" styleClass="pl-row-value" text="0.00" />
                                       </children>
                                    </HBox>
                                    <HBox>
                                       <children>
                                          <Label styleClass="pl-row-label" text="Other charges (recovered)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowOther" styleClass="pl-row-value" text="0.00" />
                                       </children>
                                    </HBox>
                                    <Region styleClass="pl-row-divider" />
                                    <HBox styleClass="pl-row-total-bar,pl-row-total-bar-pos">
                                       <children>
                                          <Label styleClass="pl-row-total" text="Total Revenue (A)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowTotalRevenue" styleClass="pl-row-total" text="0.00" />
                                       </children>
                                    </HBox>

                                    <Label styleClass="pl-section-title" text="Cost of Goods Sold" />
                                    <HBox>
                                       <children>
                                          <Label styleClass="pl-row-label" text="Purchase Invoices" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowPurchase" styleClass="pl-row-value" text="0.00" />
                                       </children>
                                    </HBox>
                                    <Region styleClass="pl-row-divider" />
                                    <HBox styleClass="pl-row-total-bar,pl-row-total-bar-neg">
                                       <children>
                                          <Label styleClass="pl-row-total" text="Total COGS (B)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowTotalCogs" styleClass="pl-row-total" text="0.00" />
                                       </children>
                                    </HBox>

                                    <HBox styleClass="pl-row-total-bar">
                                       <children>
                                          <Label styleClass="pl-row-total" text="Gross Profit (A − B)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowGrossProfit" styleClass="pl-row-total" text="0.00" />
                                       </children>
                                    </HBox>

                                    <Label styleClass="pl-section-title" text="Operating Expenses" />
                                    <HBox>
                                       <children>
                                          <Label styleClass="pl-row-label" text="Employee Commissions Paid" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowCommissions" styleClass="pl-row-value" text="0.00" />
                                       </children>
                                    </HBox>
                                    <HBox>
                                       <children>
                                          <Label styleClass="pl-row-label" text="Labour Charges Paid" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowLabour" styleClass="pl-row-value" text="0.00" />
                                       </children>
                                    </HBox>
                                    <HBox>
                                       <children>
                                          <Label styleClass="pl-row-label" text="Salesman Cutting Charges" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowCutting" styleClass="pl-row-value" text="0.00" />
                                       </children>
                                    </HBox>
                                    <Region styleClass="pl-row-divider" />
                                    <HBox styleClass="pl-row-total-bar,pl-row-total-bar-neg">
                                       <children>
                                          <Label styleClass="pl-row-total" text="Total Operating Expenses (C)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowTotalExpenses" styleClass="pl-row-total" text="0.00" />
                                       </children>
                                    </HBox>

                                    <HBox fx:id="netRowBar" styleClass="pl-row-total-bar,pl-row-total-bar-pos">
                                       <children>
                                          <Label fx:id="lblRowNetLabel" styleClass="pl-row-total" text="Net Profit (Gross − C)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="lblRowNetProfit" styleClass="pl-row-total" text="0.00" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </content>
                  </Tab>
                  <Tab text="Item Profit / Loss">
                     <content>
                        <VBox spacing="8.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <children>
                              <TableView fx:id="tableItem" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colNo" maxWidth="80.0" minWidth="40.0" prefWidth="50.0" text="Sr.No" />
                                    <TableColumn fx:id="colItemName" minWidth="180.0" prefWidth="240.0" text="Item Name" />
                                    <TableColumn fx:id="colUnit" maxWidth="80.0" minWidth="50.0" prefWidth="60.0" text="Unit" />
                                    <TableColumn fx:id="colSolQty" maxWidth="120.0" minWidth="80.0" prefWidth="100.0" text="Sold Qty" />
                                    <TableColumn fx:id="colSoldRate" maxWidth="120.0" minWidth="80.0" prefWidth="100.0" text="Sold Rate" />
                                    <TableColumn fx:id="colSoldAmount" maxWidth="160.0" minWidth="100.0" prefWidth="130.0" text="Sold Amount" />
                                    <TableColumn fx:id="colPurchaseRate" maxWidth="140.0" minWidth="90.0" prefWidth="120.0" text="Purchase Rate" />
                                    <TableColumn fx:id="colPurchaseAmount" maxWidth="160.0" minWidth="100.0" prefWidth="130.0" text="Purchase Amount" />
                                    <TableColumn fx:id="colMargin" maxWidth="160.0" minWidth="100.0" prefWidth="130.0" text="Margin" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                 <children>
                                    <Label styleClass="pl-row-label" text="Total Item Margin :" />
                                    <TextField fx:id="txtTotalMargin" editable="false" prefWidth="200.0" text="0.0">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </TextField>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </content>
                  </Tab>
                  <Tab text="Expense Breakdown">
                     <content>
                        <VBox spacing="8.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <children>
                              <TableView fx:id="tableExpense" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colExpSr" maxWidth="80.0" minWidth="40.0" prefWidth="50.0" text="Sr.No" />
                                    <TableColumn fx:id="colExpCategory" minWidth="220.0" prefWidth="320.0" text="Category" />
                                    <TableColumn fx:id="colExpCount" maxWidth="140.0" minWidth="80.0" prefWidth="120.0" text="Entries" />
                                    <TableColumn fx:id="colExpAmount" minWidth="160.0" prefWidth="240.0" text="Amount" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
