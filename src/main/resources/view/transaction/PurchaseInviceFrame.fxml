<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane"
            style="-fx-background-color: #ECEFF1;"
            xmlns="http://javafx.com/javafx/16"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.main.java.controller.transaction.PurchaseInvoiceController">
   <children>

      <VBox spacing="0.0"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

         <!-- ── HEADER BAR ─────────────────────────────────────────────── -->
         <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="12.0"
               style="-fx-background-color: #2E7D32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);">
            <padding><Insets left="16.0" right="16.0"/></padding>
            <FontAwesomeIcon fill="WHITE" glyphName="SHOPPING_CART" size="20"/>
            <Label text="PURCHASE INVOICE"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold;" text="Bill No :"/>
            <TextField fx:id="txtBillNo" prefWidth="110.0"
                       style="-fx-font-weight: bold; -fx-font-size: 14;"/>
            <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold;" text="Date :"/>
            <DatePicker fx:id="date" prefWidth="150.0" promptText="Invoice Date"/>
         </HBox>

         <!-- ── MAIN CONTENT ───────────────────────────────────────────── -->
         <HBox spacing="10.0" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>

            <!-- ── LEFT COLUMN: Party + Items ─────────────────────────── -->
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">

               <!-- Party card -->
               <VBox spacing="6.0"
                     style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                  <padding><Insets bottom="10.0" left="12.0" right="12.0" top="8.0"/></padding>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                         text="PARTY INFORMATION"/>

                  <!-- Party name selection -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <Label minWidth="80.0" style="-fx-font-weight: bold;" text="Party Name"/>
                     <ComboBox fx:id="cmbPartyName" maxWidth="Infinity" prefHeight="26.0"
                               promptText="Select Party" HBox.hgrow="ALWAYS"/>
                     <Button fx:id="btnSearch" mnemonicParsing="false"
                             onAction="#searchPurchaseParty"
                             stylesheets="@button.css" text=" SEARCH" textFill="WHITE">
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="SEARCH" size="12"/></graphic>
                     </Button>
                     <Button fx:id="btnAddParty" mnemonicParsing="false"
                             stylesheets="@button.css" text=" ADD" textFill="WHITE">
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="PLUS" size="12"/></graphic>
                     </Button>
                  </HBox>

                  <!-- Party info -->
                  <HBox alignment="TOP_LEFT" spacing="8.0">
                     <Label minWidth="80.0" style="-fx-font-weight: bold;" text="Info"/>
                     <TextArea fx:id="txtPartyInfo" editable="false" prefHeight="62.0"
                               promptText="Party details appear here" HBox.hgrow="ALWAYS"/>
                  </HBox>
               </VBox>

               <!-- Items card -->
               <VBox spacing="6.0" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                  <padding><Insets bottom="10.0" left="12.0" right="12.0" top="8.0"/></padding>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                         text="ITEMS"/>

                  <!-- Item entry row -->
                  <HBox alignment="BOTTOM_LEFT" spacing="6.0">
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold;" text="Item Name">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtItemName" onAction="#txtItemNameAction"
                                   promptText="Item Name">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Unit">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtUnit" editable="false" prefWidth="65.0"
                                   promptText="Unit">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Quantity">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtQuantity" onAction="#txtQtyAction"
                                   onKeyReleased="#txtQtyKeyEvent" prefWidth="85.0"
                                   promptText="Quantity">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Rate">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtRate" onAction="#txtRateAction"
                                   onKeyReleased="#txtRateKeyEvent" prefWidth="90.0"
                                   promptText="Rate">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="IGST %">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtIgstPct" prefWidth="70.0" promptText="0.00">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Amount">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtAmount" editable="false" prefWidth="100.0"
                                   promptText="Amount"
                                   style="-fx-background-color: #DCEDC8; -fx-font-weight: bold;">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                  </HBox>

                  <!-- Item action buttons -->
                  <HBox spacing="6.0">
                     <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#btnAddAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="ADD" textFill="WHITE">
                        <font><Font name="System Bold" size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="PLUS"/></graphic>
                     </Button>
                     <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="CLEAR" textFill="WHITE">
                        <font><Font size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="ERASER"/></graphic>
                     </Button>
                     <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#btnEditAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="EDIT" textFill="WHITE">
                        <font><Font size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="PENCIL"/></graphic>
                     </Button>
                     <Button fx:id="btnRemove" mnemonicParsing="false" onAction="#btnRemoveAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="REMOVE" textFill="WHITE">
                        <font><Font size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="CLOSE"/></graphic>
                     </Button>
                  </HBox>

                  <!-- Items table — grows to fill remaining space -->
                  <TableView fx:id="table" stylesheets="@../css/table.css" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colSrNo"     prefWidth="35.0"  text="No"/>
                        <TableColumn fx:id="colItemName" prefWidth="180.0" text="Item Name"/>
                        <TableColumn fx:id="colUnit"     prefWidth="45.0"  text="Unit"/>
                        <TableColumn fx:id="colQty"      prefWidth="65.0"  text="Qty"/>
                        <TableColumn fx:id="colRate"     prefWidth="70.0"  text="Rate"/>
                        <TableColumn fx:id="colIgstPct"  prefWidth="60.0"  text="IGST %"/>
                        <TableColumn fx:id="colIgstAmt"  prefWidth="75.0"  text="IGST Amt"/>
                        <TableColumn fx:id="colAmount"   prefWidth="90.0"  text="Amount"/>
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                     </columnResizePolicy>
                  </TableView>

               </VBox>
            </VBox>

            <!-- ── RIGHT COLUMN: Invoice No + Payment + Totals + Buttons ── -->
            <VBox spacing="8.0" prefWidth="460.0">

               <!-- Payment & Totals card -->
               <VBox spacing="6.0" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                  <padding><Insets bottom="12.0" left="12.0" right="12.0" top="8.0"/></padding>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                         text="PAYMENT &amp; TOTALS"/>

                  <GridPane hgap="6.0" vgap="8.0">
                     <columnConstraints>
                        <ColumnConstraints halignment="LEFT" minWidth="100.0" prefWidth="115.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                        <ColumnConstraints halignment="LEFT" minWidth="100.0" prefWidth="115.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="30.0"/>
                        <RowConstraints minHeight="30.0"/>
                        <RowConstraints minHeight="30.0"/>
                        <RowConstraints minHeight="30.0"/>
                        <RowConstraints minHeight="30.0"/>
                     </rowConstraints>

                     <!-- Row 0: Invoice No | txtInvoiceNo | Net Total | txtNetTotal -->
                     <Label style="-fx-font-weight: bold;" text="Party Inv. No."
                            GridPane.rowIndex="0"/>
                     <TextField fx:id="txtInvoiceNo" maxWidth="Infinity" prefHeight="28.0"
                                promptText="Enter Invoice No"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                     <Label style="-fx-font-weight: bold;" text="Net Total"
                            GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                     <TextField fx:id="txtNetTotal" editable="false" maxWidth="Infinity"
                                prefHeight="28.0" text="0.0"
                                style="-fx-background-color: #A5D6A7; -fx-font-weight: bold; -fx-font-size: 14;"
                                GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>

                     <!-- Row 1: Payment From | cmbpaymentFrom | IGST Total | txtGst -->
                     <Label style="-fx-font-weight: bold;" text="Payment From"
                            GridPane.rowIndex="1"/>
                     <ComboBox fx:id="cmbpaymentFrom" maxWidth="Infinity" prefHeight="28.0"
                               promptText="Select Bank"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                     <Label style="-fx-font-weight: bold;" text="IGST Total"
                            GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                     <TextField fx:id="txtGst" editable="false" maxWidth="Infinity"
                                prefHeight="28.0" text="0.0"
                                style="-fx-background-color: #B2EBF2; -fx-font-weight: bold; -fx-font-size: 14;"
                                GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>

                     <!-- Row 2: Trans. Reff | txtTransactionReff | Other Chargs | txtOtherChrgs -->
                     <Label style="-fx-font-weight: bold;" text="Trans. Reff"
                            GridPane.rowIndex="2"/>
                     <TextField fx:id="txtTransactionReff" maxWidth="Infinity" prefHeight="28.0"
                                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                     <Label style="-fx-font-weight: bold;" text="Other Chargs"
                            GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                     <TextField fx:id="txtOtherChrgs" maxWidth="Infinity" prefHeight="28.0"
                                text="0.0" onAction="#txtOtherChrgsAction"
                                onKeyReleased="#txtOtherChrgsKeyEvent"
                                style="-fx-background-color: #DCEDC8; -fx-font-weight: bold;"
                                GridPane.columnIndex="3" GridPane.rowIndex="2">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>

                     <!-- Row 3: Paid Amount | txtPaidAmount | Transport Chrgs | txtTransportChrgs -->
                     <Label style="-fx-font-weight: bold;" text="Paid Amount"
                            GridPane.rowIndex="3"/>
                     <TextField fx:id="txtPaidAmount" maxWidth="Infinity" prefHeight="28.0"
                                onKeyReleased="#txtPaidAmountKeyEvent"
                                style="-fx-background-color: #A5D6A7; -fx-font-weight: bold;"
                                GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>
                     <Label style="-fx-font-weight: bold;" text="Transport Chrgs"
                            GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                     <TextField fx:id="txtTransportChrgs" maxWidth="Infinity" prefHeight="28.0"
                                text="0.0" onAction="#txtTransportChargsAction"
                                onKeyReleased="#txtTransportChargsKeyEvent"
                                style="-fx-background-color: #DCEDC8; -fx-font-weight: bold;"
                                GridPane.columnIndex="3" GridPane.rowIndex="3">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>

                     <!-- Row 4: Advance Paid | txtAdvancePaid | Grand Total | txtGrandTotal -->
                     <Label style="-fx-font-weight: bold;" text="Advance Paid"
                            GridPane.rowIndex="4"/>
                     <TextField fx:id="txtAdvancePaid" editable="false" maxWidth="Infinity"
                                prefHeight="28.0" text="0.0"
                                onKeyReleased="#txtPaidAmountKeyEvent"
                                style="-fx-background-color: #A5D6A7; -fx-font-weight: bold;"
                                GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>
                     <Label style="-fx-font-weight: bold;" text="Grand Total"
                            GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                     <TextField fx:id="txtGrandTotal" editable="false" maxWidth="Infinity"
                                prefHeight="28.0" text="0.0"
                                style="-fx-background-color: #FFF59D; -fx-font-weight: bold; -fx-font-size: 14;"
                                GridPane.columnIndex="3" GridPane.rowIndex="4">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>

                  </GridPane>
               </VBox>

               <!-- Action buttons bar -->
               <HBox alignment="CENTER" spacing="8.0"
                     style="-fx-background-color: #ECEFF1; -fx-border-color: #B0BEC5; -fx-border-width: 1 0 0 0; -fx-padding: 8;">
                  <Button fx:id="btnsave" mnemonicParsing="false" onAction="#btnSaveAction"
                          prefHeight="38.0" prefWidth="90.0" text="SAVE" textFill="WHITE"
                          style="-fx-background-color: #2E7D32; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="SAVE" size="18"/></graphic>
                  </Button>
                  <Button fx:id="btnPrint" mnemonicParsing="false"
                          prefHeight="38.0" prefWidth="90.0" text="PRINT" textFill="WHITE"
                          style="-fx-background-color: #4527A0; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="PRINT" size="18"/></graphic>
                  </Button>
                  <Button fx:id="btnClear2" mnemonicParsing="false" onAction="#btnClear2Action"
                          prefHeight="38.0" prefWidth="90.0" text="CLEAR" textFill="WHITE"
                          style="-fx-background-color: #E65100; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="ERASER" size="18"/></graphic>
                  </Button>
                  <Button fx:id="btnBack" mnemonicParsing="false" onAction="#backAction"
                          prefHeight="38.0" prefWidth="90.0" text="BACK" textFill="WHITE"
                          style="-fx-background-color: #546E7A; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="ARROW_LEFT" size="18"/></graphic>
                  </Button>
               </HBox>

            </VBox>
         </HBox>
      </VBox>

   </children>
</AnchorPane>
