<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPanel" prefHeight="820.0" prefWidth="1100.0"
    style="-fx-background-color: #ECEFF1;"
    xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="main.java.main.java.controller.transaction.BillControler">
   <center>
      <VBox spacing="0.0">

         <!-- ── HEADER BAR ──────────────────────────────────────────────── -->
         <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="12.0"
               style="-fx-background-color: #1565C0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 4, 0, 0, 2);">
            <padding><Insets left="16.0" right="16.0"/></padding>
            <FontAwesomeIcon fill="WHITE" glyphName="FILE_TEXT" size="20"/>
            <Label fx:id="lblMode" text="NEW BILL"
                   style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold;" text="Bill No :"/>
            <TextField fx:id="txtBillNo" editable="false" prefWidth="120.0"
                       style="-fx-font-weight: bold; -fx-font-size: 14;"/>
            <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold;" text="Date :"/>
            <DatePicker fx:id="date" prefWidth="150.0" promptText="Billing Date"/>
         </HBox>

         <!-- ── MAIN CONTENT ───────────────────────────────────────────── -->
         <HBox spacing="10.0" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>

            <!-- LEFT COLUMN : Customer + Items -->
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">

               <!-- Customer card -->
               <VBox spacing="6.0"
                     style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                  <padding><Insets bottom="10.0" left="12.0" right="12.0" top="8.0"/></padding>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #1565C0;"
                         text="CUSTOMER INFORMATION"/>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <Label minWidth="70.0" style="-fx-font-weight: bold;" text="Customer"/>
                     <TextField fx:id="txtCustomerName" onAction="#customerNameAction"
                                promptText="Enter Customer Name" HBox.hgrow="ALWAYS"/>
                     <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#searchCustomer"
                             stylesheets="@button.css" text=" SEARCH" textFill="WHITE">
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="SEARCH" size="12"/></graphic>
                     </Button>
                     <Button fx:id="btnNew" mnemonicParsing="false" onAction="#btnNewAction"
                             stylesheets="@button.css" text=" NEW" textFill="WHITE">
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="PLUS" size="12"/></graphic>
                     </Button>
                  </HBox>
                  <HBox alignment="TOP_LEFT" spacing="8.0">
                     <Label minWidth="70.0" style="-fx-font-weight: bold;" text="Info"/>
                     <TextArea fx:id="txtCustomerInfo" editable="false" prefHeight="62.0"
                               promptText="Customer details appear here" HBox.hgrow="ALWAYS"/>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <Label minWidth="70.0" style="-fx-font-weight: bold;" text="Salesman"/>
                     <ComboBox fx:id="cmbSalesman" maxWidth="Infinity" promptText="Select Salesman"
                               HBox.hgrow="ALWAYS"/>
                  </HBox>
               </VBox>

               <!-- Items card -->
               <VBox spacing="6.0" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                  <padding><Insets bottom="10.0" left="12.0" right="12.0" top="8.0"/></padding>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #1565C0;"
                         text="ITEMS"/>
                  <!-- Item entry fields row -->
                  <HBox alignment="BOTTOM_LEFT" spacing="6.0">
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold;" text="Item Name">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtItemName" onAction="#searchItem" promptText="Item Name">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Rate">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtRate" prefWidth="90.0" promptText="Rate">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Qty Unit">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtUnit" editable="false" prefWidth="65.0" promptText="Unit">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Quantity">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtQty" onAction="#txtQtyAction" onKeyReleased="#txtQtyKeyEvent"
                                   prefWidth="85.0" promptText="Quantity">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="Amount">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtAmount" prefWidth="90.0" promptText="Amount">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                     <VBox spacing="2.0">
                        <Label style="-fx-font-weight: bold;" text="IGST %">
                           <font><Font size="13.0"/></font>
                        </Label>
                        <TextField fx:id="txtIgstPct" prefWidth="70.0" promptText="0.00">
                           <font><Font size="13.0"/></font>
                        </TextField>
                     </VBox>
                  </HBox>
                  <!-- Item action buttons -->
                  <HBox spacing="6.0">
                     <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#btnAddAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="ADD" textFill="WHITE">
                        <font><Font name="System Bold" size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="PLUS"/></graphic>
                     </Button>
                     <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="CLEAR" textFill="WHITE">
                        <font><Font size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="ERASER"/></graphic>
                     </Button>
                     <Button fx:id="btnRemove" mnemonicParsing="false" onAction="#btnremoveAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="REMOVE" textFill="WHITE">
                        <font><Font size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="CLOSE"/></graphic>
                     </Button>
                     <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#btnUpdateAction"
                             prefHeight="30.0" prefWidth="90.0" stylesheets="@button.css"
                             text="UPDATE" textFill="WHITE">
                        <font><Font size="13.0"/></font>
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="EDIT"/></graphic>
                     </Button>
                  </HBox>
                  <!-- Items table -->
                  <TableView fx:id="table" stylesheets="@../css/table.css" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colSrNo"     prefWidth="33.0"  text="No"/>
                        <TableColumn fx:id="colItemName" prefWidth="170.0" text="Item Name"/>
                        <TableColumn fx:id="colUnit"     prefWidth="40.0"  text="Unit"/>
                        <TableColumn fx:id="colQty"      prefWidth="60.0"  text="Qty"/>
                        <TableColumn fx:id="colRate"     prefWidth="65.0"  text="Rate"/>
                        <TableColumn fx:id="colAmount"   prefWidth="85.0"  text="Amount"/>
                        <TableColumn fx:id="colIgstPct"  prefWidth="55.0"  text="IGST %"/>
                        <TableColumn fx:id="colIgstAmt"  prefWidth="75.0"  text="IGST Amt"/>
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                     </columnResizePolicy>
                  </TableView>
               </VBox>

            </VBox>

            <!-- RIGHT COLUMN : Payment + Totals + Action buttons -->
            <VBox spacing="8.0" prefWidth="480.0">

               <!-- Payment & Totals card -->
               <VBox spacing="6.0" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 4; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 3, 0, 0, 1);">
                  <padding><Insets bottom="10.0" left="12.0" right="12.0" top="8.0"/></padding>
                  <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #1565C0;"
                         text="PAYMENT &amp; TOTALS"/>

                  <!-- Payment grid -->
                  <GridPane hgap="6.0" vgap="6.0">
                     <columnConstraints>
                        <ColumnConstraints halignment="LEFT" minWidth="95.0" prefWidth="105.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="110.0"/>
                        <ColumnConstraints halignment="LEFT" minWidth="90.0" prefWidth="100.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="100.0"/>
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                     </rowConstraints>
                     <!-- Row 0 -->
                     <Label style="-fx-font-weight: bold;" text="Recieved By" GridPane.rowIndex="0"/>
                     <ComboBox fx:id="cmbRecievedBy" maxWidth="Infinity" prefHeight="26.0"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                     <Label style="-fx-font-weight: bold;" text="Net Total"
                            GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                     <TextField fx:id="txtNetTotal" editable="false" maxWidth="Infinity" prefHeight="26.0"
                                style="-fx-background-color: #A5D6A7; -fx-font-weight: bold; -fx-font-size: 14;" text="0.0"
                                GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>
                     <!-- Row 1 -->
                     <Label style="-fx-font-weight: bold;" text="Reff. No" GridPane.rowIndex="1"/>
                     <TextField fx:id="txtReffNo" maxWidth="Infinity" prefHeight="26.0"
                                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                     <Label style="-fx-font-weight: bold;" text="Transp. Chrgs."
                            GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                     <TextField fx:id="txtTransoChrgs" maxWidth="Infinity" onAction="#txtTranspChrgsAction"
                                prefHeight="26.0" style="-fx-background-color: #DCEDC8; -fx-font-weight: bold;" text="0.0"
                                GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>
                     <!-- Row 2 -->
                     <Label style="-fx-font-weight: bold;" text="Bank/Mode" GridPane.rowIndex="2"/>
                     <ComboBox fx:id="cmbBankName" maxWidth="Infinity" prefHeight="26.0"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                     <Label style="-fx-font-weight: bold;" text="Other Chrgs."
                            GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                     <TextField fx:id="txtOtherChargs" maxWidth="Infinity" onAction="#txtOtherChargesAction"
                                prefHeight="26.0" style="-fx-background-color: #DCEDC8; -fx-font-weight: bold;" text="0.0"
                                GridPane.columnIndex="3" GridPane.rowIndex="2">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>
                     <!-- Row 3: IGST Total -->
                     <Label style="-fx-font-weight: bold;" text="" GridPane.rowIndex="3"/>
                     <Label style="-fx-font-weight: bold;" text="" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                     <Label style="-fx-font-weight: bold;" text="IGST Total"
                            GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                     <TextField fx:id="txtIgstTotal" editable="false" maxWidth="Infinity" prefHeight="26.0"
                                style="-fx-background-color: #B2EBF2; -fx-font-weight: bold; -fx-font-size: 14;" text="0.0"
                                GridPane.columnIndex="3" GridPane.rowIndex="3">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>
                     <!-- Row 4 -->
                     <Label style="-fx-font-weight: bold;" text="Recieved Amt." GridPane.rowIndex="4"/>
                     <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <TextField fx:id="txtReivedAmount" prefHeight="26.0"
                                   style="-fx-background-color: #A5D6A7; -fx-font-weight: bold;"
                                   HBox.hgrow="ALWAYS">
                           <font><Font name="System Bold" size="14.0"/></font>
                        </TextField>
                        <Button fx:id="btnAddPayment" mnemonicParsing="false" onAction="#btnAddPaymentAction"
                                prefHeight="26.0" stylesheets="@button.css" text="ADD PAY" textFill="WHITE">
                           <graphic><FontAwesomeIcon fill="WHITE" glyphName="PLUS"/></graphic>
                        </Button>
                     </HBox>
                     <Label style="-fx-font-weight: bold;" text="Grand Total"
                            GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                     <TextField fx:id="txtGrandTotal" editable="false" maxWidth="Infinity" prefHeight="26.0"
                                style="-fx-background-color: #FFF59D; -fx-font-weight: bold; -fx-font-size: 14;" text="0.0"
                                GridPane.columnIndex="3" GridPane.rowIndex="4">
                        <font><Font name="System Bold" size="14.0"/></font>
                     </TextField>
                  </GridPane>

                  <!-- Payment splits table -->
                  <TableView fx:id="tablePayments" minHeight="90.0" prefHeight="110.0"
                             stylesheets="@../css/table.css">
                     <columns>
                        <TableColumn fx:id="colPayBank"   prefWidth="120.0" text="Bank/Mode"/>
                        <TableColumn fx:id="colPayRef"    prefWidth="130.0" text="Ref No"/>
                        <TableColumn fx:id="colPayAmount" prefWidth="100.0" text="Amount"/>
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                     </columnResizePolicy>
                  </TableView>

                  <!-- Remove payment + totals row -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <Button fx:id="btnRemovePayment" mnemonicParsing="false"
                             onAction="#btnRemovePaymentAction"
                             prefHeight="26.0" prefWidth="120.0" stylesheets="@button.css"
                             text="REMOVE PAY" textFill="WHITE">
                        <graphic><FontAwesomeIcon fill="WHITE" glyphName="CLOSE"/></graphic>
                     </Button>
                     <Region HBox.hgrow="ALWAYS"/>
                     <Label style="-fx-font-weight: bold;" text="Total Received"/>
                     <TextField fx:id="txtTotalRecieved" editable="false" prefWidth="90.0"
                                style="-fx-background-color: #FFF59D; -fx-font-weight: bold;" text="0.0">
                        <font><Font name="System Bold" size="13.0"/></font>
                     </TextField>
                     <Label style="-fx-font-weight: bold;" text="Balance"/>
                     <TextField fx:id="txtBalanceDue" editable="false" prefWidth="80.0"
                                style="-fx-background-color: #ff8a80; -fx-font-weight: bold;" text="0.0">
                        <font><Font name="System Bold" size="12.0"/></font>
                     </TextField>
                  </HBox>
               </VBox>

               <!-- Action buttons -->
               <HBox alignment="CENTER" spacing="8.0"
                     style="-fx-background-color: #ECEFF1; -fx-border-color: #B0BEC5; -fx-border-width: 1 0 0 0; -fx-padding: 8;">
                  <Button fx:id="btnSave" mnemonicParsing="false" onAction="#btnSaveAction"
                          prefHeight="38.0" prefWidth="90.0" text="SAVE" textFill="WHITE"
                          style="-fx-background-color: #2E7D32; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="SAVE" size="18"/></graphic>
                  </Button>
                  <Button fx:id="btnPrint" mnemonicParsing="false" onAction="#btnPrintAction"
                          prefHeight="38.0" prefWidth="90.0" text="PRINT" textFill="WHITE"
                          style="-fx-background-color: #4527A0; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="PRINT" size="18"/></graphic>
                  </Button>
                  <Button fx:id="btnClearBill" mnemonicParsing="false" onAction="#btnClearBillAction"
                          prefHeight="38.0" prefWidth="90.0" text="CLEAR" textFill="WHITE"
                          style="-fx-background-color: #E65100; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="ERASER" size="18"/></graphic>
                  </Button>
                  <Button fx:id="btnExit" mnemonicParsing="false" onAction="#btnExitAction"
                          prefHeight="38.0" prefWidth="90.0" text="BACK" textFill="WHITE"
                          style="-fx-background-color: #546E7A; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 3;">
                     <font><Font name="System Bold" size="14.0"/></font>
                     <graphic><FontAwesomeIcon fill="WHITE" glyphName="ARROW_LEFT" size="18"/></graphic>
                  </Button>
               </HBox>

            </VBox>
         </HBox>
      </VBox>
   </center>
</BorderPane>
